# Salin ke .env lalu isi. Nilai di sini contoh/dummy, bukan kunci produksi.

# Database
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/pt_amp"

# URL publik situs (tanpa "/" di akhir). WAJIB di produksi: dipakai canonical,
# og:url, hreflang dan URL di JSON-LD. Tanpa ini fallback ke BETTER_AUTH_URL,
# lalu http://localhost:$PORT — canonical produksi jadi salah.
NEXT_PUBLIC_SITE_URL="https://www.contoh-domain.co.id"

# Better Auth
BETTER_AUTH_SECRET="ganti-dengan-string-acak-panjang"
BETTER_AUTH_URL="http://localhost:3000"

# Password user hasil seed (prisma/seed.ts)
SEED_PASSWORD="ganti-password"

# Penyimpanan file S3 (opsional)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET_NAME=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ROOT_DIR=""
